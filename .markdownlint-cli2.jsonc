{
  "globs": [
    "docs/**/*.md",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CONTEXT.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
  ],
  "config": {
    "line-length": false,
  },
  "overrides": [
    {
      "filter": ["CLAUDE.md"],
      "config": {
        "MD041": false,
      },
      "combine": "merge",
    },
  ],
}
